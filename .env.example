APP_NAME=GymControl
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost


LOG_CHANNEL=stderr
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gymcontrol
DB_USERNAME=root
DB_PASSWORD=


SESSION_DRIVER=cookie
SESSION_LIFETIME=120

# Set only for explicit first-time operator provisioning; remove after seeding.
GYMCONTROL_BOOTSTRAP_OWNER_EMAIL=
GYMCONTROL_BOOTSTRAP_OWNER_PASSWORD=
GYMCONTROL_BOOTSTRAP_RECEPTION_EMAIL=
GYMCONTROL_BOOTSTRAP_RECEPTION_PASSWORD=

CACHE_STORE=array
QUEUE_CONNECTION=database

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=local-gymcontrol
# Generate unique values for each installation; keep REVERB_APP_SECRET private.
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_ALLOWED_ORIGINS=localhost,127.0.0.1
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Cambiar a false para permitir acceso desde internet
TERMINAL_SOLO_RED_LOCAL=false
